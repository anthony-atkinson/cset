    };

    private async Task OnSubmit()
    {
        if (IsSubmitting) return;
        
        IsSubmitting = true;
        ValidationMessages.Clear();
        
        try
        {
            // Validate the model
            if (!ValidateModel())
            {
                IsSubmitting = false;
                return;
            }
            
            // Create the assessment
            var assessment = await AssessmentService.CreateAssessmentAsync(AssessmentModel);
            
            if (assessment != null)
            {
                await OnAssessmentCreated.InvokeAsync(assessment);
                Navigation.NavigateTo($"/assessment/{assessment.AssessmentId}");
            }
            else
            {
                ValidationMessages.Add("Failed to create assessment. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ValidationMessages.Add($"Error creating assessment: {ex.Message}");
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task OnCancel()
    {
        await OnCancelled.InvokeAsync();
    }

    private bool ValidateModel()
    {
        ValidationMessages.Clear();
        
        if (string.IsNullOrWhiteSpace(AssessmentModel.AssessmentName))
        {
            ValidationMessages.Add("Assessment name is required.");
        }
        
        if (string.IsNullOrWhiteSpace(AssessmentModel.AssessmentType))
        {
            ValidationMessages.Add("Assessment type is required.");
        }
        
        if (string.IsNullOrWhiteSpace(AssessmentModel.FacilityName))
        {
            ValidationMessages.Add("Facility name is required.");
        }
        
        return !ValidationMessages.Any();
    }

    private List<string> GetValidationMessages(string propertyName)
    {
        return ValidationMessages.Where(m => m.Contains(propertyName, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    public class AssessmentCreateModel
    {
        public string AssessmentName { get; set; } = string.Empty;
        public string AssessmentType { get; set; } = string.Empty;
        public string FacilityName { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string State { get; set; } = string.Empty;
        public string Sector { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public bool UseStandard { get; set; } = true;
        public bool UseMaturityModel { get; set; } = false;
    }
} 