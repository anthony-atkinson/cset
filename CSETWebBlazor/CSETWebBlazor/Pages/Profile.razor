@page "/profile"
@attribute [Authorize]
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject IApiClientService ApiClient

<PageTitle>Profile - CSET</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>User Profile</h2>
            <p class="text-muted">Manage your account settings and preferences</p>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading profile...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Profile Information</h5>
                    </div>
                    <div class="card-body">
                        <form @onsubmit="UpdateProfile">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <input type="text" class="form-control" id="firstName" @bind="UserProfile.FirstName" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <input type="text" class="form-control" id="lastName" @bind="UserProfile.LastName" />
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" @bind="UserProfile.Email" readonly />
                                <div class="form-text">Email cannot be changed</div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="organization" class="form-label">Organization</label>
                                <input type="text" class="form-control" id="organization" @bind="UserProfile.Organization" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="jobTitle" class="form-label">Job Title</label>
                                <input type="text" class="form-control" id="jobTitle" @bind="UserProfile.JobTitle" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="phone" class="form-label">Phone</label>
                                <input type="tel" class="form-control" id="phone" @bind="UserProfile.Phone" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="timezone" class="form-label">Timezone</label>
                                <select class="form-select" id="timezone" @bind="UserProfile.Timezone">
                                    <option value="UTC">UTC</option>
                                    <option value="America/New_York">Eastern Time</option>
                                    <option value="America/Chicago">Central Time</option>
                                    <option value="America/Denver">Mountain Time</option>
                                    <option value="America/Los_Angeles">Pacific Time</option>
                                </select>
                            </div>
                            
                            <button type="submit" class="btn btn-primary" disabled="@IsUpdating">
                                @if (IsUpdating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Save Changes</span>
                                }
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Account Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <strong>User ID:</strong><br />
                            <span class="text-muted">@UserProfile.UserId</span>
                        </div>
                        <div class="mb-3">
                            <strong>Role:</strong><br />
                            <span class="badge bg-@GetRoleColor(UserProfile.Role)">@UserProfile.Role</span>
                        </div>
                        <div class="mb-3">
                            <strong>Member Since:</strong><br />
                            <span class="text-muted">@UserProfile.CreatedDate.ToString("MM/dd/yyyy")</span>
                        </div>
                        <div class="mb-3">
                            <strong>Last Login:</strong><br />
                            <span class="text-muted">@UserProfile.LastLoginDate?.ToString("MM/dd/yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Security</h5>
                    </div>
                    <div class="card-body">
                        <button class="btn btn-outline-primary w-100 mb-2" @onclick="ChangePassword">
                            <i class="oi oi-lock me-2"></i>Change Password
                        </button>
                        <button class="btn btn-outline-secondary w-100" @onclick="ViewLoginHistory">
                            <i class="oi oi-clock me-2"></i>Login History
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool IsLoading { get; set; } = true;
    private bool IsUpdating { get; set; } = false;
    private UserProfile UserProfile { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadUserProfile();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user profile: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadUserProfile()
    {
        try
        {
            // This would call the API to get user profile
            // For now, we'll create mock data
            UserProfile = new UserProfile
            {
                UserId = "USR001",
                FirstName = "John",
                LastName = "Doe",
                Email = "john.doe@example.com",
                Organization = "Sample Organization",
                JobTitle = "Security Analyst",
                Phone = "+1 (555) 123-4567",
                Timezone = "America/New_York",
                Role = "User",
                CreatedDate = DateTime.Now.AddYears(-1),
                LastLoginDate = DateTime.Now.AddHours(-2)
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user profile: {ex.Message}");
        }
    }

    private async Task UpdateProfile()
    {
        IsUpdating = true;
        try
        {
            // This would call the API to update the profile
            Console.WriteLine("Updating user profile...");
            await Task.Delay(1000); // Simulate API call
            
            // Show success message
            Console.WriteLine("Profile updated successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating profile: {ex.Message}");
        }
        finally
        {
            IsUpdating = false;
        }
    }

    private void ChangePassword()
    {
        // This would open a password change dialog
        Console.WriteLine("Opening password change dialog");
    }

    private void ViewLoginHistory()
    {
        // This would navigate to login history page
        Console.WriteLine("Opening login history");
    }

    private string GetRoleColor(string role)
    {
        return role?.ToLower() switch
        {
            "admin" => "danger",
            "superuser" => "warning",
            "user" => "primary",
            _ => "secondary"
        };
    }

    public class UserProfile
    {
        public string UserId { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Organization { get; set; } = string.Empty;
        public string JobTitle { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Timezone { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public DateTime CreatedDate { get; set; }
        public DateTime? LastLoginDate { get; set; }
    }
} 