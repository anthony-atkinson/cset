@page "/resource-library"
@attribute [Authorize]
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject IApiClientService ApiClient

<PageTitle>Resource Library - CSET</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Resource Library</h2>
            <p class="text-muted">Access cybersecurity frameworks, standards, and documentation</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="oi oi-document display-4 text-primary mb-3"></i>
                    <h5 class="card-title">Frameworks</h5>
                    <p class="card-text">NIST, CMMC, CIS Controls, and more</p>
                    <button class="btn btn-primary">Browse Frameworks</button>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="oi oi-book display-4 text-success mb-3"></i>
                    <h5 class="card-title">Standards</h5>
                    <p class="card-text">ISO, NIST, and industry standards</p>
                    <button class="btn btn-success">Browse Standards</button>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="oi oi-file display-4 text-info mb-3"></i>
                    <h5 class="card-title">Templates</h5>
                    <p class="card-text">Assessment and report templates</p>
                    <button class="btn btn-info">Browse Templates</button>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="oi oi-video display-4 text-warning mb-3"></i>
                    <h5 class="card-title">Training</h5>
                    <p class="card-text">Videos and training materials</p>
                    <button class="btn btn-warning">Browse Training</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Resource Library Features Coming Soon</h5>
                </div>
                <div class="card-body">
                    <p>This section will provide access to:</p>
                    <ul>
                        <li>Cybersecurity frameworks and standards documentation</li>
                        <li>Assessment templates and checklists</li>
                        <li>Training materials and videos</li>
                        <li>Best practices and guidelines</li>
                        <li>Reference materials and white papers</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div> 