<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Charting Libraries -->
    <PackageReference Include="ScottPlot" Version="5.0.21" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.0.21" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    
    <!-- PDF Generation -->
    <PackageReference Include="iTextSharp.LGPLv2.Core" Version="3.4.15" />
    <PackageReference Include="iTextSharp" Version="5.5.13.3" />
    
    <!-- Code Editor -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="ICSharpCode.AvalonEdit" Version="6.3.0.90" />
    
    <!-- File Handling -->
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    
    <!-- Date/Time Handling -->
    <PackageReference Include="NodaTime" Version="3.1.10" />
    
    <!-- HTML Sanitization -->
    <PackageReference Include="HtmlSanitizer" Version="8.0.0" />
    
    <!-- Reactive Programming -->
    <PackageReference Include="System.Reactive" Version="6.0.0" />
    
    <!-- Authentication and Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    
    <!-- Entity Framework -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0" />
    
    <!-- SignalR -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
    
    <!-- AutoMapper -->
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    
    <!-- Validation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    
    <!-- Testing -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <PackageReference Include="bunit" Version="1.25.3" />
  </ItemGroup>

</Project>
